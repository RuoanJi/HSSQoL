<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HSSQoL</AssemblyName>
    <RootNamespace>HSSQoL</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <!-- Game install folder (the one containing KairoGames.exe and BepInEx), in order of precedence:
         1. dotnet build -p:GameDir="D:\...\High Sea Saga DX"
         2. the HSS_GAME_DIR environment variable
         3. the default Steam library location -->
    <GameDir Condition="'$(GameDir)' == ''">$(HSS_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\High Sea Saga DX</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- Reference the DLLs BepInEx ships and generates; never copy them to output. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\KairoLibrary.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Assembly-CSharp.dll" Private="false" />
  </ItemGroup>

  <!-- Fail early with a clear message instead of a wall of missing-reference errors. -->
  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.Core.dll')"
           Text="BepInEx not found in '$(GameDir)'. Set the game folder with -p:GameDir=&quot;...&quot; or the HSS_GAME_DIR environment variable, and make sure BepInEx 6 (IL2CPP x86) is installed there." />
    <Error Condition="!Exists('$(BepInExDir)\interop\Assembly-CSharp.dll')"
           Text="'$(BepInExDir)\interop' is missing. Start the game once with BepInEx installed so it generates the interop assemblies." />
  </Target>

  <!-- Drop the built plugin straight into BepInEx\plugins -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <MakeDir Directories="$(BepInExDir)\plugins" />
    <!-- The game locks the DLL while running; warn instead of failing so builds still succeed. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins" Retries="0" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Condition="'$(MSBuildLastTaskResult)' == 'true'" Text="Deployed $(TargetFileName) to $(BepInExDir)\plugins" />
    <Warning Condition="'$(MSBuildLastTaskResult)' != 'true'" Text="Not deployed: close the game and rebuild." />
  </Target>

</Project>
